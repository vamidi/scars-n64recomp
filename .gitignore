# Downloaded tool binaries
/tools/n64sym/

# RT64 checkout (renderer dependency, ~380 MB, see tools/fetch_rt64.ps1 and
# docs/SWITCH.md). Point SCARS_RT64_DIR at a checkout outside the tree instead
# if you prefer not to keep a copy here.
/thirdparty/rt64/

# Build output
/build/
/out/

# Recompiler output (generated from user-supplied inputs)
/build/generated/

# User-supplied game inputs (kept out of git)
/data/*
!/data/README.txt
*.z64
*.n64
*.v64
*.rom
*.elf
*.map
*.zip
*.7z

# Runtime user directory (config, stored ROM, saves) when running from the
# repo root; the default is <exe>/user.
/user/

# Runtime log mirror written next to the executable.
scars-log.txt

# Compiled artefacts
*.exe
*.dll
*.lib
*.obj
*.o
*.a
*.pdb
*.ilk

# Nintendo Switch packages (build/switch holds the normal output; these cover a
# copy left in the tree).
*.nro
*.nacp

# Local runtime/agent artefacts
imgui.ini
logs/
*.log

# Editors / OS metadata
.idea/
.vs/
.vscode/
.DS_Store
Thumbs.db

# OpenCode local agent state (permissions, downloaded skills, backups).
# Machine-local; do not publish these with the port.
/.opencode/
opencode.json
opencode.jsonc

# CodeGraph index (local tooling)
/.codegraph/

# Python bytecode (tools)
__pycache__/
